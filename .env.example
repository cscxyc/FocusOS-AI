# ============================================================
# FocusOS AI - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values before running.
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to Git.
# ============================================================

# ===== Database (MySQL 8.0+) =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=focusos_db
MYSQL_USER=focusos
MYSQL_PASSWORD=change-me-in-production
MYSQL_ROOT_PASSWORD=change-me-in-production

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Milvus (Vector Store for RAG) =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_COLLECTION=focusos_rag_vectors
MILVUS_DIM=1536
MILVUS_AUTO_INIT=true
MILVUS_AUTO_REBUILD=false
MILVUS_ENABLED=true

# ===== MinIO (Milvus Object Storage) =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===== JWT Authentication =====
# Must be at least 256 bits (32+ characters). Generate with:
#   openssl rand -base64 64
JWT_SECRET=please-change-this-256-bit-secret-key-in-production-environment
JWT_EXPIRATION_MS=86400000

# ===== LLM Provider (DashScope / OpenAI-compatible) =====
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_EMBEDDING_MODEL=text-embedding-v2
LLM_TIMEOUT=60

# ===== Embedding =====
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# ===== Spring Profile =====
# Options: dev, prod (use 'prod' for Docker deployment)
SPRING_PROFILES_ACTIVE=dev

# ===== Server =====
SERVER_PORT=8080
SERVER_SSL_ENABLED=false

# ===== Frontend (Next.js) =====
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===== File Upload Directory (use absolute path) =====
UPLOAD_DIR=./backend/uploads

# ===== Agent Worker Thread Pool =====
AGENT_WORKER_CORE=5
AGENT_WORKER_MAX=20
AGENT_WORKER_QUEUE=100

# ===== User Quota (Daily Token Limits) =====
DEFAULT_DAILY_TOKEN=10000
PREMIUM_DAILY_TOKEN=100000

# ===== Cache =====
CACHE_ENABLED=true

# ===== Docker Compose Ports (optional overrides) =====
BACKEND_PORT=8080
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
